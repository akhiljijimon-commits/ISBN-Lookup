# LLM — self-hosted vLLM (OpenAI-compatible API), provided by Surfgreen GmbH
LLM_API_KEY=replace-me-64-hex-chars
LLM_BASE_URL=https://vllm-api.surfgreen.ai/v1/
LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4

# Google Books — required. Anonymous requests return HTTP 429 against an
# exhausted shared daily quota, so price and description need a key.
GOOGLE_BOOKS_API_KEY=replace-me-google-books-api-key
